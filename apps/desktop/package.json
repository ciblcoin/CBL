{
  "name": "cbl-dex-desktop",
  "version": "1.0.0",
  "description": "CBL DEX Desktop Application for Windows",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "npm run build -- --win",
    "build:mac": "npm run build -- --mac",
    "build:linux": "npm run build -- --linux",
    "publish": "electron-builder --publish always",
    "test": "jest",
    "lint": "eslint ."
  },
  "build": {
    "appId": "ag.cbl.dex",
    "productName": "CBL DEX",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "publisherName": "CBL DEX"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "category": "public.app-category.finance",
      "icon": "assets/icon.icns",
      "target": "dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Finance"
    }
  },
  "dependencies": {
    "electron": "^25.0.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.0",
    "electron-log": "^5.0.0",
    "@cbl/dex-sdk": "file:../../sdk",
    "@solana/web3.js": "^1.78.0",
    "@solana/wallet-adapter": "^0.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@mui/material": "^5.14.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "axios": "^1.5.0",
    "web3": "^1.9.0",
    "node-notifier": "^10.0.0",
    "auto-launch": "^5.0.0"
  },
  "devDependencies": {
    "electron-builder": "^24.6.0",
    "electron-reloader": "^1.2.3",
    "@types/node": "^20.0.0",
    "typescript": "^5.1.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.45.0",
    "jest": "^29.6.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0"
  }
}